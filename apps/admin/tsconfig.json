{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@monorepo/shared": ["../../packages/shared/src/index.ts"],
      "@monorepo/shared/*": ["../../packages/shared/src/*"],
      "@monorepo/components": ["../../packages/components/src/index.ts"],
      "@monorepo/components/*": ["../../packages/components/src/*"],
      "@monorepo/hooks": ["../../packages/hooks/src/index.ts"],
      "@monorepo/hooks/*": ["../../packages/hooks/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/shared/src/**/*",
    "../../packages/components/src/**/*",
    "../../packages/components/src/**/*.vue",
    "../../packages/hooks/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
