{
  "name": "@packages/utils",
  "version": "1.0.0",
  "description": "共享工具函数库",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
