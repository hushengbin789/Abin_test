    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/qs": "^6.9.18",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
