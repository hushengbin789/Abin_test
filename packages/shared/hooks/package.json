{
  "name": "@mono/hooks",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 组合式函数库",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mono/utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@mono/tsconfig": "workspace:*",
    "tsup": "^8.3.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  }
}
